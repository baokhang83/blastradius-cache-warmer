<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.baokhang83.blastradius</groupId>
    <artifactId>blastradius-cache-warmer-maven-extension</artifactId>
    <version>0.3.4</version>
    <packaging>jar</packaging>

    <name>blastradius-cache-warmer-maven-extension</name>
    <description>Maven Core Extension that pre-warms sibling bytecode, segmented dependency
        slices, and incremental compiler state in CI, gated on the presence of
        blastradius-maven-plugin in the reactor.</description>
    <url>https://github.com/baokhang83/blastradius-cache-warmer</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>baokhang83</id>
            <name>Bao Khang</name>
            <url>https://github.com/baokhang83</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/baokhang83/blastradius-cache-warmer.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/baokhang83/blastradius-cache-warmer.git</developerConnection>
        <url>https://github.com/baokhang83/blastradius-cache-warmer</url>
        <tag>v0.3.4</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/baokhang83/blastradius-cache-warmer/issues</url>
    </issueManagement>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <maven.minimum.version>3.9.6</maven.minimum.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <central.skip.publishing>true</central.skip.publishing>

        <!-- Matches the maven-core version this extension is built and tested against;
             kept as `provided` so the extension reuses Maven's own classes at runtime
             instead of shading a second, possibly-conflicting copy onto the core classpath. -->
        <maven.core.version>3.9.9</maven.core.version>
        <slf4j.version>2.0.18</slf4j.version>
        <junit.version>5.10.2</junit.version>

        <!-- Not provided by Maven itself, unlike maven-core/slf4j-api above - S3SliceStore
             needs a real compile-scope client. Core Extensions resolve their own dependency
             graph into an isolated realm, so this doesn't touch Maven's own classpath. -->
        <aws.sdk.version>2.46.7</aws.sdk.version>

        <enforcer.plugin.version>3.6.3</enforcer.plugin.version>
        <sisu.plugin.version>0.9.0.M3</sisu.plugin.version>
        <source.plugin.version>3.3.1</source.plugin.version>
        <javadoc.plugin.version>3.12.0</javadoc.plugin.version>
        <gpg.plugin.version>3.2.8</gpg.plugin.version>
        <central.publishing.plugin.version>0.11.0</central.publishing.plugin.version>
    </properties>

    <!-- Pins every software.amazon.awssdk module (s3, url-connection-client, and their
         transitive siblings) to one release in lockstep, so adding a second AWS module later
         can't silently drift a version out of sync with this one. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- provided: Maven supplies these at runtime via the core classpath. Shading them
             into the extension jar would risk a second, version-skewed copy alongside
             Maven's own - the exact classpath-pollution risk a Core Extension (unlike a
             Mojo, which loads in an isolated plugin realm) can't isolate itself from. -->
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>${maven.core.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- @Named/@Singleton/@Inject - the annotations Sisu's main-index goal scans for.
             Pinned explicitly (provided) rather than relied on transitively through
             maven-core, so the version is visible here, not implied by maven-core's graph. -->
        <dependency>
            <groupId>javax.inject</groupId>
            <artifactId>javax.inject</artifactId>
            <version>1</version>
            <scope>provided</scope>
        </dependency>

        <!-- s3 pulls in apache5-client as its default runtime HTTP client; excluded because
             we supply url-connection-client below instead, and apache5-client's own transitive
             httpcore5 versions don't converge with the BOM (a version mismatch inside AWS's own
             dependency graph, unrelated to anything we chose). -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>apache5-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- The lightest-weight sync HTTP client v2 ships (java.net.HttpURLConnection under
             the hood) - avoids pulling in Apache HttpClient or Netty, which we'd otherwise need
             to satisfy S3Client's requirement for an explicit HTTP implementation. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${enforcer.plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-build-baseline</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[${maven.minimum.version},)</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                                <dependencyConvergence/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Generates META-INF/sisu/javax.inject.Named by scanning compiled classes for
                 @Named, instead of hand-maintaining that index file - the standard mechanism
                 real Maven Core Extensions (e.g. maven-build-cache-extension) use so Sisu can
                 discover CacheWarmerExtension without a components.xml. -->
            <plugin>
                <groupId>org.eclipse.sisu</groupId>
                <artifactId>sisu-maven-plugin</artifactId>
                <version>${sisu.plugin.version}</version>
                <executions>
                    <execution>
                        <id>generate-sisu-index</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>main-index</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- CI enables this profile so Blastradius can narrow the test set before Surefire runs.
             Keeping it opt-in preserves the ordinary local Maven command while making the exact
             plugin version and the tracked branch explicit and reproducible. -->
        <profile>
            <id>blastradius</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.github.baokhang83.blastradius</groupId>
                        <artifactId>blastradius-maven-plugin</artifactId>
                        <version>0.3.2</version>
                        <executions>
                            <execution>
                                <phase>process-test-classes</phase>
                                <goals>
                                    <goal>select</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <baseRef>origin/main</baseRef>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${source.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${javadoc.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${gpg.plugin.version}</version>
                        <configuration>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                            <passphraseEnvName>MAVEN_GPG_PASSPHRASE</passphraseEnvName>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-release-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central.publishing.plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                            <skipPublishing>${central.skip.publishing}</skipPublishing>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
